{
  "name": "trustvault",
  "version": "1.0.0",
  "description": "TrustVault - Secure Enterprise Document Vault & Authorization Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm install && cd client && npm install --include=dev && npm run build && cd .. && npx prisma generate && npx tsc",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "security",
    "vault",
    "rbac",
    "abac",
    "idor",
    "bola",
    "audit"
  ],
  "author": "TrustVault Security Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
