# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustvault?schema=public"

# Application Server
PORT=3000
NODE_ENV=development

# JWT Security
JWT_SECRET="trustvault-super-secure-jwt-secret-key-32-chars-minimum"
JWT_EXPIRES_IN="1h"

# Storage Configuration
# Files are stored outside public access with random UUID keys
STORAGE_DIR="./storage/vault"
